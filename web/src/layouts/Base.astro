---
// Kerangka halaman bersama: head, header, <main>. Halaman mengisi <slot />.
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import TabBar from '../components/TabBar.astro';
import { API_BASE } from '../lib/api';

interface Props {
	title?: string;
	description?: string;
	/** Nilai `data-view` tetap (halaman galat dilayani di URL mana pun, jadi tak bisa diturunkan dari path). */
	view?: string;
	/** Halaman galat tidak untuk diindeks. */
	noindex?: boolean;
}

const {
	title = 'Panel — Baca manga, manhwa & manhua',
	description = 'Baca manga, manhwa, dan manhua terbaru dengan tampilan ringan dan cepat.',
	view,
	noindex = false,
} = Astro.props;
---
<!doctype html>
<html lang="id" data-view={view}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0b0f17" media="(prefers-color-scheme: dark)" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<title>{title}</title>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<!-- Koneksi ke API (fetch CORS) dan gambar (no-cors) memakai pool socket berbeda. -->
		<link rel="preconnect" href={API_BASE} crossorigin />
		<link rel="preconnect" href={API_BASE} />
		<!-- Tema pilihan & jenis halaman diset sebelum cat pertama agar tidak berkedip. -->
		<script is:inline>
			(function () {
				var d = document.documentElement;
				try {
					var t = localStorage.getItem('mr:theme');
					if (t === 'dark' || t === 'light') d.setAttribute('data-theme', t);
				} catch (e) {}
				if (!d.getAttribute('data-view')) d.setAttribute('data-view', location.pathname.split('/')[1] || 'home');
			})();
		</script>
	</head>
	<body>
		<a class="skip" href="#main">Lewati ke konten</a>
		<Nav />
		<main id="main" class="wrap">
			<slot />
		</main>
		<TabBar />
	</body>
</html>
