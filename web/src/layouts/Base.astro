---
// Kerangka halaman bersama: head, header, <main>, footer. Halaman mengisi <slot />;
// slot `hero` (opsional) ada di dalam <main> tetapi di luar kolom `.wrap` (strip selebar layar).
// Tampilan gelap saja (tanpa tema terang & tombol tema).
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { API_BASE } from '../lib/api';
import { PANEL_MARK } from '../lib/icons';

interface Props {
	title?: string;
	description?: string;
	/** Nilai `data-view` tetap (halaman galat dilayani di URL mana pun, jadi tak bisa diturunkan dari path). */
	view?: string;
	/** Halaman galat tidak untuk diindeks. */
	noindex?: boolean;
}

const {
	title = 'Panel — Baca manga, manhwa & manhua',
	description = 'Baca manga, manhwa, dan manhua terbaru dengan tampilan ringan dan cepat.',
	view,
	noindex = false,
} = Astro.props;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="id" data-view={view}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#913FE2" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<title>{title}</title>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<!-- Koneksi ke API (fetch CORS) dan gambar (no-cors) memakai pool socket berbeda. -->
		<link rel="preconnect" href={API_BASE} crossorigin />
		<link rel="preconnect" href={API_BASE} />
		<!-- Jenis halaman diset sebelum cat pertama agar CSS (mis. reader tanpa header) tidak berkedip. -->
		<script is:inline>
			(function () {
				var d = document.documentElement;
				if (!d.getAttribute('data-view')) d.setAttribute('data-view', location.pathname.split('/')[1] || 'home');
			})();
		</script>
	</head>
	<body>
		<a class="skip" href="#main">Lewati ke konten</a>
		<Nav />
		<main id="main">
			<slot name="hero" />
			<slot />
		</main>
		<footer class="site-footer">
			<div class="wrap footer-in">
				<a class="footer-brand" href="/" aria-label="Panel, beranda"><Fragment set:html={PANEL_MARK} /><span>Panel</span></a>
				<nav class="footer-links" aria-label="Tautan kaki">
					<a href="/">Beranda</a>
					<a href="/daftar/">Daftar</a>
					<a href="/pustaka/">Pustaka</a>
				</nav>
				<p class="footer-copy">&copy; {year} Panel.</p>
			</div>
		</footer>
	</body>
</html>
