---
// Header lengket ungu: tombol menu (ponsel), logo, navigasi utama, kolom cari, tombol Pustaka.
// Di bawah 768px navigasi utama menjadi panel di bawah bar (dibuka tombol menu) dan kolom cari menjadi
// baris di bawah bar (dibuka ikon cari); keduanya digerakkan src/lib/header.ts.
// Menu aktif ditandai src/lib/site.ts; sub-menu Daftar di navmenu.ts (disclosure, juga di dalam panel ponsel);
// autocomplete (kotak #suggest) di suggest.ts, yang juga memasang atribut ARIA combobox.
// Lencana [data-bm-count] di tombol Pustaka diisi bookmarks.ts (tersembunyi bila 0).
import { ICON_BOOKMARK, ICON_CHEV_DOWN, ICON_CLOSE, ICON_MENU, ICON_SEARCH, PANEL_MARK } from '../lib/icons';
---
<header class="site-header">
	<div class="wrap bar">
		<button
			class="nav-burger"
			type="button"
			aria-label="Menu"
			aria-expanded="false"
			aria-controls="primary-nav"
			data-nav-toggle
		>
			<span class="i-open"><Fragment set:html={ICON_MENU} /></span>
			<span class="i-close"><Fragment set:html={ICON_CLOSE} /></span>
		</button>

		<a class="brand" href="/" aria-label="Panel, beranda">
			<span class="brand-mark"><Fragment set:html={PANEL_MARK} /></span>
			<span class="brand-name">Panel</span>
		</a>

		<nav class="primary-nav" id="primary-nav" aria-label="Utama">
			<a href="/" data-nav="home">Beranda</a>
			<div class="nav-drop" data-menu>
				<button type="button" class="nav-trigger" data-nav="daftar" data-menu-toggle aria-expanded="false" aria-controls="menu-daftar">
					Daftar
					<Fragment set:html={ICON_CHEV_DOWN} />
				</button>
				<ul class="nav-menu" id="menu-daftar" data-menu-list role="list" hidden>
					<li><a href="/daftar/" data-tipe="">Semua</a></li>
					<li><a href="/daftar/?tipe=manga" data-tipe="manga">Manga</a></li>
					<li><a href="/daftar/?tipe=manhwa" data-tipe="manhwa">Manhwa</a></li>
					<li><a href="/daftar/?tipe=manhua" data-tipe="manhua">Manhua</a></li>
				</ul>
			</div>
			<a href="/populer/" data-nav="populer">Populer</a>
			<a href="/terbaru/" data-nav="terbaru">Terbaru</a>
			<a href="/#genre" data-nav="genre">Genre</a>
		</nav>

		<button
			class="search-toggle"
			type="button"
			aria-label="Cari"
			aria-expanded="false"
			aria-controls="site-search"
			data-search-toggle
		>
			<Fragment set:html={ICON_SEARCH} />
		</button>

		<form class="search" id="site-search" action="/search/" method="get" role="search">
			<div class="search-field">
				<input
					id="q"
					type="search"
					name="q"
					placeholder="Cari judul…"
					aria-label="Cari manga"
					autocomplete="off"
					enterkeyhint="search"
				/>
				<button type="submit" aria-label="Cari">
					<Fragment set:html={ICON_SEARCH} />
				</button>
				<kbd class="search-kbd" aria-hidden="true" data-search-kbd>⌘K</kbd>
			</div>
			<div class="suggest" id="suggest" role="listbox" aria-label="Saran pencarian" hidden></div>
			<p class="sr-only" id="suggest-live" role="status" aria-live="polite"></p>
		</form>

		<a class="lib-btn" href="/pustaka/" data-nav="pustaka">
			<Fragment set:html={ICON_BOOKMARK} />
			<span class="lib-btn-lbl">Pustaka</span>
			<span class="nav-badge" data-bm-count hidden></span>
		</a>
	</div>
</header>
