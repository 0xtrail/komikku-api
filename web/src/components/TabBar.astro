---
// Tab bar bawah untuk ponsel (jangkauan jempol). Disembunyikan di desktop
// (header memuat menu yang sama) dan di reader (yang punya bar chapter sendiri).
// Lencana [data-bm-count] di tab Pustaka diisi bookmarks.ts (tersembunyi bila 0).
---
<nav class="tabbar" aria-label="Navigasi bawah">
	<a href="/" data-nav="home">
		<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3.5 11 12 3.8 20.5 11v8.7a1.3 1.3 0 0 1-1.3 1.3H15v-6h-6v6H4.8a1.3 1.3 0 0 1-1.3-1.3Z" fill="currentColor" /></svg>
		<span>Beranda</span>
	</a>
	<a href="/daftar/" data-nav="daftar">
		<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="5" cy="6.5" r="1.7" fill="currentColor" /><circle cx="5" cy="12" r="1.7" fill="currentColor" /><circle cx="5" cy="17.5" r="1.7" fill="currentColor" /><path d="M9.5 6.5h10M9.5 12h10M9.5 17.5h10" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
		<span>Daftar</span>
	</a>
	<a href="/terbaru/" data-nav="terbaru">
		<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2.2" /><path d="M12 7v5.2l3.4 2" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
		<span>Terbaru</span>
	</a>
	<a href="/#genre" data-nav="genre">
		<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="7.2" height="7.2" rx="2" fill="currentColor" /><rect x="13.3" y="3.5" width="7.2" height="7.2" rx="2" fill="currentColor" /><rect x="3.5" y="13.3" width="7.2" height="7.2" rx="2" fill="currentColor" /><rect x="13.3" y="13.3" width="7.2" height="7.2" rx="2" fill="currentColor" /></svg>
		<span>Genre</span>
	</a>
	<a href="/pustaka/" data-nav="pustaka">
		<span class="tab-ic">
			<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.5 3.5h11a1 1 0 0 1 1 1V20.5l-6.5-4.4-6.5 4.4V4.5a1 1 0 0 1 1-1Z" fill="currentColor" /></svg>
			<span class="nav-badge" data-bm-count hidden></span>
		</span>
		<span>Pustaka</span>
	</a>
</nav>
