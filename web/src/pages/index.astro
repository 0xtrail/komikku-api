---
// Beranda: di-prerender saat build sebagai paint pertama yang instan.
// Di browser, src/lib/client.ts (mountHome) mengambil data terbaru di latar
// belakang dan menukar section hanya bila isinya berbeda. Markup dibuat oleh
// HOME_VIEWS (src/lib/homeview.ts) — tabel yang sama dipakai klien, jadi tidak ada layout jump.
import Base from '../layouts/Base.astro';
import Panel from '../components/Panel.astro';
import SecBody from '../components/SecBody.astro';
import { getPopular, getRecommended, getNewest, getGenres } from '../lib/api';
import { daftarHref } from '../lib/routes';
import { HOME_VIEWS, type HomeKey } from '../lib/homeview';
import { ICON_CHEV_LEFT, ICON_CHEV_RIGHT } from '../lib/icons';

// Satu section yang gagal tidak boleh menggagalkan build atau section lain.
const [popular, recommended, newest, genres] = await Promise.allSettled([
	getPopular(1),
	getRecommended(1),
	getNewest(1),
	getGenres(),
]);
const ok = <T,>(r: PromiseSettledResult<T>, name: string): T | undefined => {
	if (r.status === 'fulfilled') return r.value;
	console.warn(`[index] prerender ${name} gagal: ${r.reason instanceof Error ? r.reason.message : r.reason}`);
	return undefined;
};

// Data kosong dianggap gagal: klien akan mengisinya (tampilkan skeleton, bukan "kosong").
const has = <T,>(d?: T[]) => (d && d.length ? d : undefined);
const view = (key: HomeKey, data?: unknown[]) => {
	const d = has(data);
	const v = HOME_VIEWS[key];
	return { data: d, html: d ? (v.render as (l: never) => string)(d as never) : v.skeleton };
};

const popularData = ok(popular, 'popular');
const recommendedData = ok(recommended, 'recommended');
const hero = view('hero', popularData);
const reco = view('recommended', recommendedData);
const newestSec = view('newest', ok(newest, 'newest'));
const rankPopular = view('rank-popular', popularData);
const rankReco = view('rank-recommended', recommendedData);
const genre = view('genre', ok(genres, 'genre'));
---
<Base>
	<section slot="hero" class="hero" aria-label="Sorotan populer" data-sec="hero">
		<h1 class="sr-only">Baca manga, manhwa, dan manhua online</h1>
		<SecBody class="hero-body" {...hero} />
		<button type="button" class="hero-nav hero-nav-prev" data-rail-btn="prev" data-rail-for="hero" aria-label="Geser sorotan ke kiri">
			<Fragment set:html={ICON_CHEV_LEFT} />
		</button>
		<button type="button" class="hero-nav hero-nav-next" data-rail-btn="next" data-rail-for="hero" aria-label="Geser sorotan ke kanan">
			<Fragment set:html={ICON_CHEV_RIGHT} />
		</button>
	</section>

	<div class="wrap home">
		<!-- Hanya di browser: mountResumeRail (pustaka.ts) mengisi dan menampilkannya bila ada riwayat. -->
		<Panel id="lanjut" sec="resume" title="Lanjutkan Membaca" icon="eye" more="/pustaka/" moreLabel="Pustaka" hidden>
			<div class="sec-body" data-body></div>
		</Panel>

		<nav class="quick" aria-label="Jelajahi daftar komik">
			<a class="chip chip-strong" href={daftarHref()} aria-label="Semua judul">Semua</a>
			<a class="chip" href={daftarHref('manga')}>Manga</a>
			<a class="chip" href={daftarHref('manhwa')}>Manhwa</a>
			<a class="chip" href={daftarHref('manhua')}>Manhua</a>
		</nav>

		<div class="home-cols">
			<div class="home-main">
				<Panel id="rekomendasi" sec="recommended" title="Rekomendasi" icon="star" more="/daftar/" moreLabel="Semua">
					<span slot="controls" class="rail-ctl">
						<button type="button" class="icon-btn" data-rail-btn="prev" data-rail-for="recommended" aria-label="Geser rekomendasi ke kiri">
							<Fragment set:html={ICON_CHEV_LEFT} />
						</button>
						<button type="button" class="icon-btn" data-rail-btn="next" data-rail-for="recommended" aria-label="Geser rekomendasi ke kanan">
							<Fragment set:html={ICON_CHEV_RIGHT} />
						</button>
					</span>
					<SecBody {...reco} />
				</Panel>

				<Panel id="terbaru" sec="newest" title="Update Terbaru" icon="clock" more="/terbaru/" moreLabel="Lihat semua">
					<SecBody {...newestSec} />
				</Panel>
			</div>

			<aside class="home-side" aria-label="Peringkat dan genre">
				<Panel id="populer" title="Populer" icon="flame">
					<div slot="controls" class="rank-tabs" role="tablist" aria-label="Peringkat">
						<button type="button" class="rank-tab" role="tab" id="rt-popular" data-rank-tab="popular" aria-selected="true" aria-controls="rp-popular">Populer</button>
						<button type="button" class="rank-tab" role="tab" id="rt-recommended" data-rank-tab="recommended" aria-selected="false" aria-controls="rp-recommended" tabindex="-1">Rekomendasi</button>
					</div>
					<div role="tabpanel" id="rp-popular" aria-labelledby="rt-popular" data-sec="rank-popular" data-rank-panel="popular">
						<SecBody {...rankPopular} />
					</div>
					<div role="tabpanel" id="rp-recommended" aria-labelledby="rt-recommended" data-sec="rank-recommended" data-rank-panel="recommended" hidden>
						<SecBody {...rankReco} />
					</div>
				</Panel>

				<Panel id="genre" sec="genre" title="Genre" icon="tag">
					<SecBody {...genre} />
				</Panel>
			</aside>
		</div>
	</div>
</Base>
<script>
	import '../lib/boot';
</script>
